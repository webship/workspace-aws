{
  "name": "@webship.co/workspace-aws",
  "version": "1.0.12",
  "description": "AWS Elastic Beanstalk for Webship Workspace: the AWS menu on every site row, the application's environments and their URLs, deploy a version, tail the logs, recent events, public files from S3. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A provider of @webship.co/workspace-hosting.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-aws.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "README.md",
    "ddev",
    "host-mounts.txt",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "aws",
    "label": "AWS",
    "needs": {
      "plugins": [
        [
          "dev",
          "test",
          "demos",
          "sandboxes",
          "projects"
        ],
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        {
          "command": "aws",
          "hint": "https://docs.aws.amazon.com/cli/"
        }
      ]
    },
    "settingsFile": "plugin.aws.settings.yml",
    "settingsTemplate": "config/plugin.aws.settings.yml",
    "labels": "config/settings.labels.yml",
    "legacySettingsKey": "aws",
    "typeActions": {
      "aws": [
        "sites"
      ]
    },
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "demos",
        "sandboxes",
        "projects"
      ],
      "files": [
        "commands/cmd-tools-aws.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-aws.sh",
        "scripts/functions/fun-aws-tool.sh"
      ],
      "args": [
        "scripts/args/arg-aws.sh"
      ],
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/aws-deployer.md"
      ],
      "skills": [
        "ai/skills/aws-hosting"
      ],
      "commands": [
        "ai/commands/aws-status.md"
      ],
      "prompts": [
        "ai/prompts/aws-test-then-deploy.md"
      ]
    },
    "features": [
      "features/aws.feature"
    ],
    "ddev": {
      "compose": [
        "ddev/docker-compose.aws-cli.yaml"
      ],
      "hostMounts": [
        "~/.aws"
      ]
    }
  },
  "dependencies": {
    "@webship.co/workspace-hosting": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
